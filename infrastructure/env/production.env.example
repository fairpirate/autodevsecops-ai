# ---- Production environment for AutoDevSecOps AI (VPS) ----
#
# Copy to .env at the repo root, fill in every CHANGE_ME value, then:
#   chmod 600 .env
#
# Never commit .env — it is gitignored. Secrets in this file never go to AI
# agents; they are used only by the server-side control plane.

# ---- Core ----
NODE_ENV=production
LOG_LEVEL=info

# ---- API ----
CONTROL_API_PORT=4000
# Published host ports for Docker Compose; choose unused ports on a shared VPS.
# vps-deploy.sh renders Nginx automatically; shell overrides take precedence.
# Container ports remain 4000 (API) and 80 (dashboard).
CONTROL_API_HOST_PORT=14000
DASHBOARD_HOST_PORT=18080
# Canonical public URL reachable by GitLab (webhooks + Duo flow callbacks).
PUBLIC_BASE_URL=https://autodevsecops.spiritedrobot.in
# Comma-separated "key:role" entries (roles: admin | engineer | viewer).
# Generate: openssl rand -hex 32   (per key)
API_KEYS=CHANGE_ME_ADMIN_KEY:admin

# ---- Persistence ----
# STORE=prisma persists runs/issues/releases to Postgres (production).
# STORE=memory loses everything on restart — local demos only.
STORE=prisma
# Reachable inside the Compose network (service name "postgres").
# Run ad-hoc Prisma commands via docker compose exec; no DB host port is published.
DATABASE_URL=postgresql://ads:CHANGE_ME_DB_PASSWORD@postgres:5432/autodevsecops?schema=public

# ---- Postgres credentials (match the postgres service environment) ----
POSTGRES_DB=autodevsecops
POSTGRES_USER=ads
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# ---- Redis / BullMQ ----
REDIS_URL=redis://redis:6379
# "memory" = embedded orchestrator. REQUIRED when AI_PROVIDER=nebius.
# "bullmq" = real queues for the orchestrator + execution-worker.
QUEUE_DRIVER=memory
EVENT_DRIVER=memory

# ---- GitLab ----
GITLAB_BASE_URL=https://gitlab.com
# Server-side integration token used by the platform itself
# (project access token or group access token with API access).
GITLAB_INTEGRATION_TOKEN=CHANGE_ME_GITLAB_TOKEN
# Secret used to validate incoming GitLab webhooks (X-Gitlab-Token).
# Must match the secret entered in the GitLab project webhook settings.
GITLAB_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET
# ID of the project webhook with "Send Duo flow events to this webhook" enabled.
GITLAB_FLOW_CALLBACK_HOOK_ID=

# ---- GitLab Duo Agent Platform ----
DUO_FLOW_DEFINITION=
DUO_FLOWS_ENABLED=false
AI_FALLBACK_MODE=strict

# ---- Tavily web search (security-review CVE/advisory enrichment) ----
TAVILY_API_KEY=

# ---- Nebius x NVIDIA Token Factory ----
# Set AI_PROVIDER=nebius for real NVIDIA Nemotron inference (server side only).
# Requires NEBIUS_API_KEY and QUEUE_DRIVER=memory (rejected at startup otherwise).
AI_PROVIDER=deterministic
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# ---- Workflow budgets ----
MAX_ITERATIONS=5
MAX_RUNTIME_MINUTES=60
MAX_TOKEN_BUDGET=200000
MAX_PATCH_SIZE_LINES=400
MAX_CONCURRENT_REPAIRS=2
MAX_REPEATED_FAILURES=2
MIN_VERIFICATION_CONFIDENCE=0.75

# ---- Execution isolation ----
EXEC_JOB_TIMEOUT_MS=600000
EXEC_WORK_DIR=/app/.exec-workspace
# Set true only when the Docker socket is mounted into the execution-worker container.
EXEC_USE_DOCKER=false

# ---- Dashboard ----
# Empty => the browser uses the current HTTPS origin (required when deployed).
# Set only when frontend and API live on different origins. BUILD-TIME variable:
# rebuilding is required after changing it. Do not include /api/v1.
VITE_API_BASE_URL=

# ---- Credential encryption (AES-256-GCM token vault) ----
# 32 random bytes, base64. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_KEY_BASE64=CHANGE_ME_32_BYTE_BASE64_KEY

server {
    listen 80;
    listen [::]:80;
    server_name DOMAIN_NAME;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://DOMAIN_NAME$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name DOMAIN_NAME;

    ssl_certificate /etc/letsencrypt/live/DOMAIN_NAME/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/DOMAIN_NAME/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 2m;

    # Keep API requests out of the frontend's index.html fallback.
    location = /api {
        default_type application/json;
        return 404 '{"error":{"message":"Use /api/v1/ endpoints"}}';
    }

    location ^~ /api/ {
        # No trailing slash: preserve /api/v1/... for the Express router.
        proxy_pass http://API_BINDING;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        # Stream SSE events immediately; allow long-running connections.
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_connect_timeout 10s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 60s;

        # SSE authentication currently uses a token query parameter.
        access_log off;

        # Preserve backend errors; return JSON for Nginx upstream failures.
        proxy_intercept_errors off;
        error_page 502 503 504 = @api_unavailable;
    }

    location @api_unavailable {
        default_type application/json;
        return 503 '{"error":{"message":"Control API unavailable. Check the backend service."}}';
    }

    location / {
        proxy_pass http://DASHBOARD_BINDING;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

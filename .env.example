# ---- Core ----
NODE_ENV=development
LOG_LEVEL=info

# ---- API ----
CONTROL_API_PORT=4000
CONTROL_API_BASE_URL=http://localhost:4000
# Comma-separated API keys for local dev auth (hashed keys preferred in production via API_KEY_HASHES)
API_KEYS=dev-admin-key-change-me
# PUBLIC base URL GitLab can reach (webhooks + Duo flow callbacks)
PUBLIC_BASE_URL=http://localhost:4000

# ---- Auth token encryption (32 random bytes, base64) ----
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_KEY_BASE64=CHANGE_ME_32_BYTE_BASE64_KEY_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Database ----
DATABASE_URL=postgresql://ads:ads@localhost:5432/autodevsecops?schema=public

# ---- Redis / BullMQ ----
REDIS_URL=redis://localhost:6379
# "memory" allows running without Redis (single-process demo); "bullmq" for real queues
QUEUE_DRIVER=memory
EVENT_DRIVER=memory

# ---- GitLab ----
GITLAB_BASE_URL=https://gitlab.com
# Optional server-side integration token (project access token / group access token) used by the platform itself
GITLAB_INTEGRATION_TOKEN=
# Secret used to validate incoming GitLab webhook payloads (X-Gitlab-Token)
GITLAB_WEBHOOK_SECRET=change-me-webhook-secret
# ID of the project webhook that has "Send Duo flow events to this webhook" enabled (duo_flow_callback_enabled)
GITLAB_FLOW_CALLBACK_HOOK_ID=

# ---- GitLab Duo Agent Platform ----
# workflow_definition must match a registered flow (e.g. custom flow id/version or foundational flow like developer/v1)
DUO_FLOW_DEFINITION=
# Enable dispatching AI steps through the real GitLab Duo Flows API (POST /api/v4/ai/duo_workflows/workflows)
DUO_FLOWS_ENABLED=false
# When false, AI reasoning steps run via deterministic analyzers only (clearly labeled in results)
AI_FALLBACK_MODE=strict

# ---- Workflow budgets ----
MAX_ITERATIONS=5
MAX_RUNTIME_MINUTES=60
MAX_TOKEN_BUDGET=200000
MAX_PATCH_SIZE_LINES=400
MAX_CONCURRENT_REPAIRS=2
MAX_REPEATED_FAILURES=2
MIN_VERIFICATION_CONFIDENCE=0.75

# ---- Execution isolation ----
EXEC_JOB_TIMEOUT_MS=600000
EXEC_WORK_DIR=./.exec-workspace
# Optional: run test/scan jobs inside Docker when available (falls back to local process)
EXEC_USE_DOCKER=false

# ---- Dashboard ----
VITE_API_BASE_URL=http://localhost:4000
